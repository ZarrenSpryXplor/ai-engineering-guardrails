{
  "schema_version": 1,
  "id": "opentofu",
  "type": "infrastructure",
  "description": "OpenTofu configuration and state-sensitive workflows.",
  "file_detectors": [".opentofu-version", "tofu.rc", ".tofurc", "*.tofu.tf"],
  "directory_detectors": [],
  "explicit_exclusions": ["**/.terraform/**", "**/vendor/**"],
  "dependent_packs": ["sensitive-output"],
  "conflicting_packs": [],
  "policy_fragments": ["policy.md"],
