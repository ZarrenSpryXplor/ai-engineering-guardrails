{
  "schema_version": 1,
  "id": "helm",
  "type": "infrastructure",
  "description": "Helm charts and release workflows compatible with supported Helm 3 and Helm 4 forms.",
  "file_detectors": ["Chart.yaml", "Chart.lock", "values.yaml", "values.schema.json"],
  "dependency_manifests": ["Chart.yaml"],
  "dependency_lockfiles": ["Chart.lock"],
  "directory_detectors": ["charts", "templates"],
  "explicit_exclusions": ["**/vendor/**", "**/node_modules/**", "**/dist/**"],
  "dependent_packs": ["kubernetes", "sensitive-output"],
  "conflicting_packs": [],
  "policy_fragments": ["policy.md"],
  "skills": ["skills/workstation-helm/SKILL.md"],
  "command_policy_fragments": ["command-policy.json"],
  "verification_definitions": ["verification.json"],
  "routing_additions": ["routing.json"],
  "compatibility_notes": ["No Helm major version is assumed; repository constraints or installed version must be inspected."]
}
