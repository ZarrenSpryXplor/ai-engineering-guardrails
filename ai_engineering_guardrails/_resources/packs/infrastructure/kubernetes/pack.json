{
  "schema_version": 1,
  "id": "kubernetes",
  "type": "infrastructure",
  "description": "Kubernetes manifests and kubectl workflows with lifecycle-aware remote-operation controls.",
  "file_detectors": ["kustomization.yaml", "kustomization.yml", "Chart.yaml", "skaffold.yaml", "Tiltfile", "*.k8s.yaml", "*.k8s.yml"],
  "directory_detectors": ["manifests", "k8s", "overlays"],
  "explicit_exclusions": ["**/vendor/**", "**/charts/**/templates/tests/**", "**/dist/**"],
  "dependent_packs": ["sensitive-output"],
  "conflicting_packs": [],
  "policy_fragments": ["policy.md"],
  "skills": ["skills/workstation-kubernetes/SKILL.md"],
  "command_policy_fragments": ["command-policy.json"],
  "verification_definitions": ["verification.json"],
  "routing_additions": ["routing.json"],
  "compatibility_notes": ["Generic YAML is intentionally not a detector; explicit manifest naming or Kubernetes directories are required."]
}
