{
  "schema_version": 1,
  "thresholds": {
    "review_files": 12,
    "high_files": 35,
    "review_lines": 300,
    "high_lines": 1000,
    "review_directories": 6,
    "high_directories": 12,
    "review_generated_share_percent": 60,
    "high_risk_paths": 1,
    "new_runtime_dependencies": 2
  },
  "generated_prefixes": ["adapters/", "build/", "dist/", "generated/"],
  "manifest_names": ["package.json", "pyproject.toml", "pom.xml", "build.gradle", "build.gradle.kts", "Directory.Packages.props", "*.csproj", "*.fsproj"],
  "lockfile_names": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock", "poetry.lock", "uv.lock", "Pipfile.lock", "Cargo.lock", "packages.lock.json"],
  "ci_governance_prefixes": [".github/", ".azure-pipelines/"],
  "ci_governance_names": ["azure-pipelines.yml", "azure-pipelines.yaml", "CODEOWNERS", "SECURITY.md", "CONTRIBUTING.md"],
  "infrastructure_extensions": [".tf", ".rego"],
  "language_extensions": {
    ".cs": "C#",
    ".fs": "F#",
    ".go": "Go",
    ".java": "Java",
    ".js": "JavaScript",
    ".jsx": "JavaScript",
    ".kt": "Kotlin",
    ".kts": "Kotlin",
    ".py": "Python",
    ".rb": "Ruby",
    ".rs": "Rust",
    ".swift": "Swift",
    ".ts": "TypeScript",
    ".tsx": "TypeScript"
  }
}
